# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Packaging / distribution
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
# The x64 venv holding vosk, created by scripts/setup_voice_gate.py. Separate
# from the main environment on purpose: on Windows ARM64 it is built from an
# emulated x64 interpreter, so its wheels are the wrong architecture for the
# native one.
.venv-vosk/
# The two venvs for the QNN speaker-verification backend, created by
# scripts/setup_speakerid_qnn.py: an x64 one (feature extraction, has torch)
# and a native ARM64 one (Hexagon NPU inference via onnxruntime-qnn). Kept
# separate from the main environment for the same architecture reasons as
# .venv-vosk above.
.venv-speakerid-x64/
.venv-speakerid-arm64/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Captured audio and debug recordings (WavRecorderSink output).
# Small fixture WAVs for FileSource tests are deliberately kept.
*.wav
!tests/fixtures/*.wav
recordings/

# Wake-phrase snippets (VoiceGateSink output).
snippets/

# Speech models. vosk-model-small-en-us-0.15 is ~40 MB unpacked and is
# fetched by scripts/setup_voice_gate.py -- never committed. Also covers
# models/speakerid/campplus_qnn.onnx, exported by
# scripts/export_speakerid_qnn.py.
models/

# Enrolled speaker embeddings (scripts/enroll_speaker.py output). Biometric
# data specific to whoever ran enrollment on this machine -- never committed.
enrolled_speakers.json

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
